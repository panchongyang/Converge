flowchart TB
  DSHC["DSH client<br/>槽位注册<br/>HTTP · 宿主桥"]
  SHELL["独立网页入口<br/>browser"]
  subgraph UI["ui/src"]
    APP["app<br/>共用应用壳"]
    MOD["modules<br/>树阅读 · 节点详情 · 变更与确认"]
    MODEL["models<br/>选中 · 展开<br/>未提交输入"]
    HOOK["hooks<br/>通用交互"]
    CMP["components<br/>通用原子件"]
    TYPES["types<br/>CognitionClient / HostBridge"]
  end
  BCL["browser<br/>本地 client"]
  SERVER["adapters/dsh/<br/>src/server"]
  KERNEL["kernel/src"]

  DSHC -->|"装配"| APP
  SHELL -->|"装配"| APP
  APP --> MOD
  MOD --> MODEL
  MOD --> HOOK
  MOD --> CMP
  MODEL -->|"依赖端口"| TYPES
  DSHC -->|"实现端口"| TYPES
  BCL -->|"实现端口"| TYPES
  DSHC -->|"HTTP"| SERVER
  BCL -->|"同一真内核"| KERNEL
  TYPES -.->|"只 import type"| KERNEL

  classDef target fill:#e8f1ff,stroke:#2f6fd0,stroke-width:1.5px,color:#10233f
  classDef landed fill:#e7f7ed,stroke:#2e7d4f,stroke-width:1.5px,color:#12351f
  classDef future fill:#f4f5f7,stroke:#8a94a6,stroke-width:1.5px,stroke-dasharray:6 4,color:#3f4753
  class DSHC,SHELL,APP,MOD,MODEL,HOOK,CMP,TYPES,BCL,SERVER,KERNEL target

