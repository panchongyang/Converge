%%{init: {"theme":"base","themeVariables":{"fontFamily":"Microsoft YaHei, Segoe UI, sans-serif","fontSize":"15px","lineColor":"#5b6b82","edgeLabelBackground":"#ffffff","clusterBkg":"#fbfcfe","clusterBorder":"#c3cedd"},"flowchart":{"curve":"basis","htmlLabels":false}}}%%
flowchart LR
  TOOLS["入口：dsh tools"]
  WIRE["可信工作区与 actor<br/>首次调用启动工作线程"]
  ROUTES["入口：dsh routes"]
  CAT["catalog<br/>按身份取子集"]
  MODELS["models<br/>唯一写入口"]
  CMD["commands<br/>树语义"]
  OPS["operations<br/>纯变更原语"]
  QRY["queries<br/>读投影"]
  PORT["TreeStore 契约"]
  FS["工作区/.converge/<br/>每树一个 SQLite 主库"]

  TOOLS --> WIRE
  ROUTES --> WIRE
  WIRE -->|"actor + 请求"| CAT
  CAT -->|"分派用例"| MODELS
  MODELS -->|"提交：校验意图"| CMD
  CMD -->|"显式变更"| OPS
  CAT -->|"只读用例"| QRY
  QRY -->|"开快照"| PORT
  MODELS -->|"持久化"| PORT
  PORT -->|"注入的实现"| FS

  classDef target fill:#e8f1ff,stroke:#2f6fd0,stroke-width:1.5px,color:#10233f
  classDef landed fill:#e7f7ed,stroke:#2e7d4f,stroke-width:1.5px,color:#12351f
  classDef future fill:#f4f5f7,stroke:#8a94a6,stroke-width:1.5px,stroke-dasharray:6 4,color:#3f4753
  class TOOLS,ROUTES,WIRE,CAT,MODELS,CMD,OPS,QRY,PORT,FS target

