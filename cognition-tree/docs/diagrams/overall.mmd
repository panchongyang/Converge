%%{init: {"theme":"base","themeVariables":{"fontFamily":"Microsoft YaHei, Segoe UI, sans-serif","fontSize":"15px","lineColor":"#5b6b82","edgeLabelBackground":"#ffffff","clusterBkg":"#fbfcfe","clusterBorder":"#c3cedd"},"flowchart":{"curve":"basis","htmlLabels":false}}}%%
flowchart TB
  HUMAN["人"]
  AGENT["DSH Agent"]
  PANEL["DSH 侧栏主面板<br/>/ 聊天提议卡"]
  WEB["独立网页"]
  DSHC["adapters/dsh/src/client<br/>槽位注册 · HTTP · 宿主桥"]
  BCL["adapters/browser<br/>本地 client"]
  UI["ui/src<br/>共用应用壳<br/>功能模块 · UI 模型"]
  PORT["ui/src/types<br/>CognitionClient / HostBridge"]
  TOOLS["dsh/src/server/host<br/>AI 工具"]
  SRV["dsh/src/server/host<br/>人侧路由"]
  CAT["kernel/src/catalog"]
  MODELS["kernel/src/models"]
  STORE["TreeStore 契约"]
  FS["工作区/.converge/<br/>单树 SQLite"]
  BS["独立网页：内存索引<br/>localStorage 测试存储"]
  MCP["MCP 适配器<br/>（未来，v1 不实现）"]:::future

  HUMAN -->|"打开"| PANEL
  HUMAN -->|"打开"| WEB
  AGENT -->|"工具调用"| TOOLS
  PANEL -->|"装配"| DSHC
  WEB -->|"装配"| BCL
  DSHC -->|"挂载同一<br/>应用壳"| UI
  BCL -->|"挂载同一<br/>应用壳"| UI
  UI -->|"调用端口"| PORT
  DSHC -->|"实现端口"| PORT
  BCL -->|"实现端口"| PORT
  DSHC -->|"HTTP / JSON"| SRV
  BCL -->|"同一操作目录，不经 DSH"| CAT
  TOOLS --> CAT
  SRV --> CAT
  CAT -->|"按身份分派"| MODELS
  MODELS -->|"持久化"| STORE
  STORE -->|"DSH 注入"| FS
  STORE -->|"独立网页注入"| BS
  MCP -.->|"未来：接同一 catalog"| CAT

  classDef target fill:#e8f1ff,stroke:#2f6fd0,stroke-width:1.5px,color:#10233f
  classDef landed fill:#e7f7ed,stroke:#2e7d4f,stroke-width:1.5px,color:#12351f
  classDef future fill:#f4f5f7,stroke:#8a94a6,stroke-width:1.5px,stroke-dasharray:6 4,color:#3f4753
  class HUMAN,AGENT,PANEL,WEB,DSHC,BCL,UI,PORT,TOOLS,SRV,CAT,MODELS,STORE,FS,BS target

