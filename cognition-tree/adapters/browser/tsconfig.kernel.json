{
  "//": "样例数据（fixtures）只允许 ES 标准库：不带 DOM、Node 或 Vite 的环境类型，确保它可直接译成正式内核的 SeedTree。",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": []
  },
  "include": [
    "src/fixtures/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
